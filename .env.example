# Database Configuration
DATABASE_URL=postgresql://nitter_user:nitter_pass@postgres:5432/nitter_db

# PostgreSQL Configuration (for Docker)
POSTGRES_USER=nitter_user
POSTGRES_PASSWORD=nitter_pass
POSTGRES_DB=nitter_db

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-this-to-a-random-secret-key

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# TwitterAPI.io - Fast, Reliable Twitter API
# Sign up at https://twitterapi.io/ to get your API key
# Free tier: 500 requests/month
# Paid: $0.15 per 1K tweets (much cheaper than official Twitter API)
TWITTERAPIIO_API_KEY=your_api_key_here

# Monitoring Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/nitter_scraper.log
