# Database Configuration
DATABASE_URL=postgresql://nitter_user:nitter_pass@localhost:5432/nitter_db

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-this-to-a-random-secret-key

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Scraping Configuration
MIN_REQUEST_DELAY=2
MAX_REQUEST_DELAY=8
MAX_RETRIES=3
HEALTH_CHECK_INTERVAL=300
REQUEST_TIMEOUT=30

# Twitter Direct Scraping (scrapes twitter.com directly, no API needed)
USE_TWITTER_DIRECT=true

# Option 1: Use cookies (RECOMMENDED - more secure, no 2FA issues)
TWITTER_COOKIES_FILE=twitter_cookies.json

# Option 2: Use username/password (fallback if cookies not provided)
TWITTER_USERNAME=your_twitter_username
TWITTER_PASSWORD=your_twitter_password

# Proxy Configuration (optional)
USE_PROXY=false
PROXY_URL=

# Monitoring Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/nitter_scraper.log
